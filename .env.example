# Choose stdio or loopback-only streamable-http.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Single mikr.us target. Prefer MCP_SERVERS for multiple or SSH targets.
MIKRUS_API_KEY=replace-me
MIKRUS_SERVER_NAME=srv123

# Immutable process identity and scopes.
MCP_PRINCIPAL=local-operator
MCP_ALLOWED_SCOPES=tool:*,target:*

# Mutations are disabled by default. General-purpose raw commands are not exposed.
MCP_WRITE_ENABLED=false
# MCP_APPROVAL_FILE=/run/secrets/mikrus-approvals.json
# Issue records from the trusted operator shell with scripts/approval.py. The model
# never receives an approval identifier, and the running process reloads atomic file replacements.

# Required only for Streamable HTTP; file mode must be 0600.
# MCP_HTTP_BEARER_TOKEN_FILE=/run/secrets/mikrus-http-token

MCP_DEFAULT_DEADLINE_MS=10000
MCP_MAX_REQUEST_BODY_BYTES=1048576
MCP_MAX_RESULT_BYTES=1000000
MCP_ALLOW_INSECURE_SSH=false
